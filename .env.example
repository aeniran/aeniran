# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# Comma-separated Telegram user IDs allowed to use the bot. Get yours from @userinfobot.
# Required: anyone who can message the bot would otherwise be able to spend your Cursor usage.
TELEGRAM_ALLOWED_USER_IDS=123456789

# Cursor API key: Cursor Dashboard -> API Keys (user key or service-account key)
CURSOR_API_KEY=key_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Default repository for new agents. Can be changed per chat with /repo <url>.
DEFAULT_REPO_URL=https://github.com/your-org/your-repo

# Optional: default branch / ref to start from (defaults to the repo's default branch)
# DEFAULT_STARTING_REF=main

# Optional: model id from GET https://api.cursor.com/v1/models. Omit to use your Cursor default.
# CURSOR_MODEL=

# Optional: open a PR automatically when a run finishes (default: true)
# AUTO_CREATE_PR=true

# Optional: where chat -> agent state is persisted (default: ./data/state.json)
# STATE_FILE=./data/state.json

# Optional overrides, mainly for testing
# CURSOR_API_BASE=https://api.cursor.com
# TELEGRAM_API_BASE=https://api.telegram.org
